generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Block {
  id                String  @id @default(uuid())
  nome              String
  descricao         String?
  contato           String?
  foto              String?
  localLat          Float?
  localLng          Float?
  cidade            String?
  estado            String?
  endereco          String?
  vertenteFeminista String?
  formacao          String?
  atividades        String?
  dias              String?
  imagens           String?
  redesSociais      String?
  ownerId           String?
  videos            String?
  eventos           Event[] @relation("BlockEvents")
}

model Event {
  id        String   @id @default(uuid())
  nome      String
  data      DateTime
  descricao String?
  foto      String?
  blocoId   String
  local     String?
  cidade    String?
  estado    String?
  tipo      String?
  horario   String?
  bloco     Block    @relation("BlockEvents", fields: [blocoId], references: [id])
}
